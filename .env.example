# ---- AI for picking highlights + writing captions (optional) ----
# auto = use whichever key is present, else Ollama if running, else heuristic
CLIPFORGE_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# CLIPFORGE_LLM_MODEL=claude-sonnet-4-5
# CLIPFORGE_OLLAMA_HOST=http://localhost:11434

# ---- Transcription ----
CLIPFORGE_WHISPER_MODEL=small        # tiny | base | small | medium | large-v3
CLIPFORGE_WHISPER_DEVICE=auto        # auto | cpu | cuda

# ---- Clips ----
CLIPFORGE_DEFAULT_CLIP_COUNT=5
CLIPFORGE_MIN_CLIP_SECONDS=15
CLIPFORGE_MAX_CLIP_SECONDS=60
CLIPFORGE_DEFAULT_STYLE=hormozi

# ---- Browser publishing ----
CLIPFORGE_BROWSER_CHANNEL=chromium   # chromium | chrome | msedge  (chrome = use your installed Google Chrome)
