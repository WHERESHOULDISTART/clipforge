{
  "name": "MrBeast",
  "description": "Cartoonish chunky font, rainbow word colors, huge bounce.",
  "font": "Luckiest Guy",
  "font_file": "LuckiestGuy-Regular.ttf",
  "font_size": 132,
  "uppercase": true,
  "words_per_line": 3,
  "max_line_seconds": 2.0,
  "primary_color": "#FFFFFF",
  "highlight_color": "#00E5FF",
  "word_colors": [
    "#FFE600",
    "#FF3B6B",
    "#4DFF7C",
    "#00E5FF"
  ],
  "outline_color": "#000000",
  "outline": 11,
  "shadow": 5,
  "highlight_mode": "color",
  "highlight_scale": 116,
  "line_pop": true,
  "position_y": 0.66,
  "letter_spacing": 2,
  "reframe": "crop"
}
